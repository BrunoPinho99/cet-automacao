# =============================================================================
# CET AUTOMAÇÃO — VARIÁVEIS DE AMBIENTE
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA comite o arquivo .env. Use um cofre de segredos em produção.
# =============================================================================

# --- Banco de dados ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=cet
POSTGRES_PASSWORD=TROQUE_AQUI
POSTGRES_DB=cet_automacao
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}"

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=TROQUE_AQUI

# --- API ---
API_PORT=3001
API_SECRET_KEY=TROQUE_AQUI_MINIMO_32_CHARS
NODE_ENV=development

# --- Portal (Next.js público) ---
PORTAL_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Admin (Next.js interno) ---
ADMIN_PORT=3002

# --- JWT ---
JWT_SECRET=TROQUE_AQUI_MINIMO_64_CHARS
JWT_EXPIRES_IN=8h

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_VERIFY_TOKEN=cet_seguranca_2026
WHATSAPP_ACCESS_TOKEN=OBTER_NO_META_DEVELOPER_PORTAL
WHATSAPP_PHONE_NUMBER_ID=OBTER_NO_META_DEVELOPER_PORTAL
WHATSAPP_APP_SECRET=OBTER_NO_META_DEVELOPER_PORTAL

# --- Instagram (Meta) ---
INSTAGRAM_VERIFY_TOKEN=cet_instagram_2026
INSTAGRAM_ACCESS_TOKEN=OBTER_NO_META_DEVELOPER_PORTAL
INSTAGRAM_APP_SECRET=OBTER_NO_META_DEVELOPER_PORTAL

# --- Asaas ---
ASAAS_API_KEY=OBTER_NO_PAINEL_ASAAS
# Sandbox: https://sandbox.asaas.com/api/v3
# Produção: https://api.asaas.com/v3
ASAAS_API_URL=https://sandbox.asaas.com/api/v3
ASAAS_WEBHOOK_SECRET=TROQUE_AQUI

# --- Ploomes ---
PLOOMES_USER_KEY=OBTER_NO_PAINEL_PLOOMES
PLOOMES_API_URL=https://api2.ploomes.com

# --- E-mail (SMTP via Mailhog em dev) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="CET Automação <noreply@cet.com.br>"
EMAIL_RELATORIO_DESTINO=diretoria@cet.com.br

# --- Mailhog (Interface web dev) ---
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# --- Upload / Storage ---
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
# Para produção, use S3 ou equivalente:
# STORAGE_PROVIDER=s3
# AWS_REGION=us-east-1
# AWS_BUCKET=cet-arquivos
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- URL pública do portal (usado para gerar links de retomada) ---
SITE_URL=http://localhost:3000

# --- Limites e configurações operacionais ---
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=30
UPLOAD_MAX_SIZE_MB=20

# --- Log ---
LOG_LEVEL=debug
