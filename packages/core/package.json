{
  "name": "@cet/core",
  "version": "0.0.1",
  "private": true,
  "description": "Motor de regras: score comercial, score SST e classificação de rotas — puro, sem I/O",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "@cet/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@vitest/coverage-v8": "^2.1.8",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
