{
  "name": "@cet/worker",
  "version": "0.0.1",
  "private": true,
  "description": "Background worker para processamento de filas e rotinas assíncronas",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cet/db": "workspace:*",
    "@cet/shared": "workspace:*",
    "bullmq": "^5.7.8",
    "puppeteer": "^22.12.0",
    "ioredis": "^5.4.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  }
}
