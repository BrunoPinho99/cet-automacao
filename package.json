{
  "name": "cet-automacao",
  "version": "0.0.1",
  "private": true,
  "description": "Sistema de Automação Comercial e Diagnóstico SST da CET",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "db:migrate": "pnpm --filter @cet/db migrate:dev",
    "db:migrate:prod": "pnpm --filter @cet/db migrate:deploy",
    "db:seed": "pnpm --filter @cet/db seed",
    "db:studio": "pnpm --filter @cet/db studio",
    "docker:up": "docker compose -f infra/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker-compose.yml down",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
